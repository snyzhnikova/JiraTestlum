<globalTestConfiguration xmlns="http://www.testlum.com/testing/model/global-config"
                         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                         xsi:schemaLocation="http://www.testlum.com/testing/model/global-config global-config.xsd">

    <parallelExecution>false</parallelExecution>
    <stopScenarioOnFailure>false</stopScenarioOnFailure>
    <stopIfInvalidScenario>false</stopIfInvalidScenario>
    <delayBetweenScenarioRuns enabled="true" seconds="1"/>

    <runScenariosByTag enabled="true">
        <tag enabled="true" name="web"/>
        <tag enabled="true" name="api"/>
    </runScenariosByTag>

    <report>
        <extentReports onlyFailedScenarios="false"
                       projectName="testlumProjectJiraTestrail">
            <htmlReportGenerator enabled="true"/>
            <klovServerReportGenerator enabled="false">
                <mongoDB host="localhost" port="27017"/>
                <klovServer url="http://localhost:80"/>
            </klovServerReportGenerator>
        </extentReports>
    </report>

    <environments>
        <env enabled="true"
             folder="local"
             threads="1"/>
    </environments>

</globalTestConfiguration>